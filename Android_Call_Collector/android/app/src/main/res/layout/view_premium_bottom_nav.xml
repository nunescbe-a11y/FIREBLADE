<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/premiumBottomNav"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@drawable/bg_premium_nav"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView android:id="@+id/navHomeIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_premium_home" />
        <TextView android:id="@+id/navHomeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Home" android:textColor="#7E7A73" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navAssigned"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView android:id="@+id/navAssignedIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_premium_assigned" />
        <TextView android:id="@+id/navAssignedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Assigned" android:textColor="#7E7A73" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView android:id="@+id/navHistoryIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_premium_history" />
        <TextView android:id="@+id/navHistoryLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="History" android:textColor="#7E7A73" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navCallbacks"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView android:id="@+id/navCallbacksIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_premium_phone" />
        <TextView android:id="@+id/navCallbacksLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Callbacks" android:textColor="#7E7A73" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView android:id="@+id/navProfileIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_premium_person" />
        <TextView android:id="@+id/navProfileLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Profile" android:textColor="#7E7A73" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
