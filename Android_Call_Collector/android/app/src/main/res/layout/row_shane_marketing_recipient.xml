<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/marketingRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_shane_employee_row"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvMarketingInitials"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_premium_avatar"
        android:fontFamily="@font/source_serif_4"
        android:gravity="center"
        android:text="ME"
        android:textColor="#171717"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMarketingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/source_serif_4"
            android:maxLines="1"
            android:text="Employee"
            android:textColor="#171717"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMarketingAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/source_serif_4"
            android:text="Ready on WhatsApp"
            android:textColor="#6B665E"
            android:textSize="11sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cbMarketingSelect"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:buttonTint="#174EA6"
        android:gravity="center"
        android:padding="8dp" />
</LinearLayout>
