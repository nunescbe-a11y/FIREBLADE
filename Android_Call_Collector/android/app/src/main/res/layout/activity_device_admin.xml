<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3ED"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_premium_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device administration"
                android:textColor="#171717"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registered device"
                android:textColor="#C7D6F1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAdminDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Not configured"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminEmployee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Waiting for server assignment"
                android:textColor="#D9E6FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAdminState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Not enrolled"
                android:textColor="#D9E6FF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_premium_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fireblade API"
                android:textColor="#6B665E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAdminApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Not configured"
                android:textColor="#171717"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Installed version"
                android:textColor="#6B665E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAdminVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Unknown"
                android:textColor="#171717"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_premium_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSetupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enrollment"
                android:textColor="#171717"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSetupDeviceId"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@android:drawable/edit_text"
                android:hint="Device ID"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etSetupApiUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@android:drawable/edit_text"
                android:hint="HTTPS Fireblade API URL"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etEnrollmentCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@android:drawable/edit_text"
                android:hint="One-time enrollment code"
                android:inputType="textPassword"
                android:singleLine="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnroll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Verify and connect"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepairEnrollment"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Repair this phone's enrollment"
            android:textAllCaps="false"
            android:textColor="#171717"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:strokeColor="#D9D4CB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshWorkspace"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Refresh Fireblade configuration"
            android:textAllCaps="false"
            android:textColor="#171717"
            app:cornerRadius="16dp"
            app:strokeColor="#D9D4CB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUpdate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Check verified app update"
            android:textAllCaps="false"
            android:textColor="#171717"
            app:cornerRadius="16dp"
            app:strokeColor="#D9D4CB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstallUpdate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Install verified update"
            android:textAllCaps="false"
            android:visibility="gone"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/tvAdminMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#6B665E"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
