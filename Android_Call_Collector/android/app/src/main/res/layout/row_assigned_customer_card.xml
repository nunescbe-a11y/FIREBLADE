<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_premium_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Customer Name"
            android:textColor="#171717"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUrgentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_overdue"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="VERY URGENT"
            android:textColor="#B43A3A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_pending"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Pending"
            android:textColor="#174EA6"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCustomerPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="+91 98765 43210"
        android:textColor="#174EA6"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProductLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Product Asked • Location"
        android:textColor="#45423E"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvShaneNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Shane Notes..."
        android:textColor="#6B665E"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#E8E4DC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSourceTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Original Shane's Handover"
            android:textColor="#8D877E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvAssignedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09 Oct 2026, 10:30 AM"
            android:textColor="#8D877E"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/savedDetailsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#F0EDE6"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSavedCheckboxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quotation: Yes • Catalogue: No • Image: Yes"
            android:textColor="#16794B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSavedRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Remarks: Called customer, sent PDF quote."
            android:textColor="#3D3A36"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSavedTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Saved at: 09 Oct 2026, 10:45 AM"
            android:textColor="#8D877E"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
