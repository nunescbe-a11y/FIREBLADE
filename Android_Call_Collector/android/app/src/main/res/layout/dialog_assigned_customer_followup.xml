<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FDFBF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Details"
            android:textColor="#171717"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+91 98765 43210"
            android:textColor="#174EA6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Product • Location"
            android:textColor="#45423E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDialogShaneNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F0EDE6"
            android:padding="10dp"
            android:text="Shane Notes..."
            android:textColor="#3D3A36"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Employee Follow-up Checklist"
            android:textColor="#171717"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Quotation checkbox row -->
        <LinearLayout
            android:id="@+id/rowQuotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shane_checkbox_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quotation"
                    android:textColor="#171717"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formal pricing or quote sent"
                    android:textColor="#6B665E"
                    android:textSize="11sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbQuotation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#174EA6" />
        </LinearLayout>

        <!-- Images checkbox row -->
        <LinearLayout
            android:id="@+id/rowImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shane_checkbox_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Images"
                    android:textColor="#171717"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product photos or site pictures shared"
                    android:textColor="#6B665E"
                    android:textSize="11sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#174EA6" />
        </LinearLayout>

        <!-- Catalogue checkbox row -->
        <LinearLayout
            android:id="@+id/rowCatalogue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shane_checkbox_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catalogue"
                    android:textColor="#171717"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product catalogue or brochure shared"
                    android:textColor="#6B665E"
                    android:textSize="11sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbCatalogue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#174EA6" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Common Remarks"
            android:textColor="#171717"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCommonRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_premium_card"
            android:gravity="top|start"
            android:hint="Enter follow-up remarks..."
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="12dp"
            android:textColor="#171717"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSavedNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Saving updates all responses with a single IST timestamp."
            android:textColor="#8D877E"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
