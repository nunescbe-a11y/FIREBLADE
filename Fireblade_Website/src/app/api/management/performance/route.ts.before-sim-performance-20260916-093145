import { NextResponse } from "next/server";
import { getSession } from "@/lib/auth";
import { supabaseRest } from "@/lib/supabase";

const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
function dateEpoch(date: string) { return Date.parse(`${date}T00:00:00+05:30`); }

type PerformanceRow = {
  employee_id: string;
  employee_name: string;
  department_id: string | null;
  department_name: string;
  profile_photo_updated_at: string | null;
  total_incoming: number;
  answered_calls: number;
  missed_calls: number;
  called_back: number;
  pending_callbacks: number;
  callback_rate: number;
  average_callback_minutes: number | null;
};

export async function GET(request: Request) {
  const user = await getSession();
  if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  if (user.role !== "ADMIN" && user.role !== "MANAGEMENT") return NextResponse.json({ error: "Management access required" }, { status: 403 });
  const url = new URL(request.url);
  const from = (url.searchParams.get("from") || "").trim();
  const to = (url.searchParams.get("to") || "").trim();
  if (!DATE_RE.test(from) || !DATE_RE.test(to)) return NextResponse.json({ error: "Valid from/to dates are required" }, { status: 400 });
  const start = dateEpoch(from);
  const end = dateEpoch(to) + 86_400_000;
  if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start || end - start > 366 * 86_400_000) return NextResponse.json({ error: "Invalid date range" }, { status: 400 });
  try {
    const rows = await supabaseRest<PerformanceRow[]>("rpc/fireblade_employee_call_performance", {
      method: "POST",
      body: JSON.stringify({ p_start_epoch_ms: start, p_end_epoch_ms: end }),
    });
    return NextResponse.json({ from, to, generated_at: new Date().toISOString(), rows });
  } catch (error) {
    console.error("[Fireblade Gen2.1 performance]", error);
    return NextResponse.json({ error: error instanceof Error ? error.message : "Could not load employee performance" }, { status: 500 });
  }
}
