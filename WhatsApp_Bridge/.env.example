PORT=3100
FIREBLADE_WHATSAPP_BRIDGE_KEY=replace-with-a-long-random-secret
FIREBLADE_WWEBJS_AUTH_PATH=.wwebjs_auth
# Optional. Windows auto-detects installed Chrome/Edge. Set this only when using a custom browser path.
FIREBLADE_WHATSAPP_BROWSER_PATH=
# Comma-separated HTTPS host names permitted for Supabase Storage attachment downloads.
FIREBLADE_MEDIA_ALLOWED_HOSTS=YOUR_PROJECT.supabase.co
FIREBLADE_WHATSAPP_MAX_MEDIA_MB=20
FIREBLADE_WHATSAPP_MAX_ATTACHMENTS=20
# Required when Fireblade sends catalogue files directly from the existing private Google Drive index.
# Share the catalogue source folders/files with this service account's client_email.
# You may use a dedicated Drive readonly service account. FIREBASE_SERVICE_ACCOUNT_JSON is used as a fallback.
FIREBLADE_GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
